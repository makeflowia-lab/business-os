# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token
ALLOWED_CHAT_ID=your-telegram-chat-id

# Voice (optional)
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Analytics Supabase (optional)
ANALYTICS_SUPABASE_URL=
ANALYTICS_SUPABASE_KEY=

# Mission Control Dashboard (optional)
MISSION_CONTROL_URL=http://localhost:3000/api/openclaw/event
MISSION_CONTROL_TOKEN=your-secret-token
MC_SERVER_PORT=3099
MISSION_CONTROL_ORIGIN=http://localhost:3000

# Google Workspace (optional)
GOG_KEYRING_PASSWORD=
GOG_ENABLE_COMMANDS=

# Image Generation (optional)
# OpenRouter API key for image generation via Gemini. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Scheduler (optional)
# Zona horaria usada para interpretar las expresiones cron (IANA, ej. America/Mexico_City).
SCHEDULER_TZ=UTC
# Anti-estampida: al arrancar, las tareas vencidas se reprograman separadas por N minutos.
STARTUP_STAGGER_MINUTES=3
# Espaciado entre tareas dentro de un mismo poll, en ms (evita varios Claude Code a la vez).
SCHEDULER_TASK_GAP_MS=2000
# Backoff ante errores transitorios (límite de cuota, 429, red): 15 → 30 → 60 min (tope 60).
SCHEDULER_RETRY_BASE_MINUTES=15
# Reintentos máximos antes de dar el slot por perdido y avanzar al siguiente.
SCHEDULER_MAX_RETRIES=3

# Agent model (optional)
# Modelo usado en las corridas del scheduler. Vacío = modelo default del CLI.
# Útil si agotaste la cuota de un modelo y quieres apuntar los crons a otro.
# Ejemplos: claude-sonnet-5, claude-opus-4-8, claude-fable-5
AGENT_MODEL=

# Multi-project orchestration (optional)
# JSON de una línea: mapa nombre → ruta absoluta. Las rutas deben existir en disco.
# Si se omite, se usa el default (socialflow, campanas, crm). Ver env-snippets/orchestrator.env
AGENT_PROJECTS=
